{
  "name": "privacyflow",
  "private": true,
  "version": "1.0.58",
  "type": "module",
  "main": "build/electron/main.js",
  "author": {
    "name": "ModernFix Pros, LLC"
  },
  "description": "PrivacyFlow — local-first Data Subject Request (DSR) management with a tamper-evident audit trail.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "mkdir -p build/electron && esbuild electron/main.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=build/electron/main.js && esbuild electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=build/electron/preload.js && printf '{\"type\":\"commonjs\"}\\n' > build/electron/package.json",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win portable --x64",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@kenjiuno/msgreader": "^1.28.0",
    "@tanstack/react-table": "8.20.5",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "build": {
    "appId": "com.mag364.privacyflow",
    "productName": "PrivacyFlow",
    "copyright": "Copyright © 2026 ModernFix Pros, LLC",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "dist/**/*",
      "build/electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.0.0",
    "autoprefixer": "10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "7.3.1",
    "vitest": "2.1.8"
  }
}
